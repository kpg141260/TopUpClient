{
    "use_color": true,
    "logFormat": {
        "txt_notset":   "",
        "txt_debug":    "debug",
        "txt_info":     "info",
        "txt_warning":  "warning",
        "txt_error":    "error",
        "txt_critical": "critical",
        "txt_trace":    "trace",
        "ts_enabled":   true,
        "pad_lbl":      true,
        "ts_format":    "%Y-%m-%d %H:%M:%S",
        "evt_format":   "%lid% %ts% %lbl% %dvc% %adr% %src% %cls% %fnc% %pid% %msg%",
        "lid_value":    1,
        "lid_format":   "06d",
        "lid_prefix":   "",
        "adr_brackets": ["@", ""],
        "cls_brackets": ["<", ">"],
        "dvc_brackets": ["|", "|"],
        "fnc_brackets": ["{", "}"],
        "lvl_brackets": ["[", "]"],
        "pid_brackets": ["(", ")"],
        "src_brackets": ["[", "]"],
        "separator":    " "
    },
    "logColors": {
        "notset":   "\u001b[38;5;8m",
        "debug" :   "\u001b[38;5;19m",
        "info"  :   "\u001b[38;5;46m",
        "warning":  "\u001b[38;5;178m",
        "error" :   "\u001b[38;5;9m",
        "critical": "\u001b[1;3;38;5;196m",
        "trace":    "\u001b[38;5;105m",
        "acc":      "\u001b[38;5;106m",
        "adr":      "\u001b[4;38;5;69m",
        "cls":      "\u001b[38;5;99m",
        "dvc":      "\u001b[38;5;200m",
        "fnc":      "\u001b[38;5;190m",
        "lid":      "\u001b[38;5;45m",
        "par":      "\u001b[1;38;5;33m",
        "pid":      "\u001b[38;5;135m",
        "ts":       "\u001b[38;5;240m",
        "syn":      "\u001b[38;5;40m",
        "xtr":      "\u001b[1;38;5;69m",
        "end":      "\u001b[0m"
    },
    "dbg_lvls_descriptions": {
        "OFF":      "off",
        "DEBUG":    "debug",
        "INFO":     "info",
        "WARNING":  "warning",
        "ERROR":    "error",
        "CRITICAL": "critical",
        "TRACE":    "trace"
    },
    "logLevelMap":{
        "-1": "off",
        "10": "debug",
        "20": "info",
        "30": "warning",
        "40": "error",
        "50": "critical",
        "60": "trace"
    }

}
